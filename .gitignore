# 忽略环境配置
/.env
/.env.*
!/.env.example

# 凭据密钥（.enc 加密文件可入库，.key 严禁入库）
/config/credentials/*.key
/config/master.key

# 依赖
/vendor/bundle
/node_modules

# 日志与临时文件
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/.gitkeep

# Active Storage 本地存储
/storage/*
!/storage/.keep

# Tailwind 构建产物
/app/assets/builds/*
!/app/assets/builds/.keep

# OS/IDE
.DS_Store
*.swp
.idea/
.vscode/

# Android 构建产物
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/captures/
/android/.cxx/
