# 生产环境必配（复制为 .env 或注入到容器环境）

# Rails 安全（生产凭据在 config/credentials/production.yml.enc，解密密钥即 RAILS_MASTER_KEY）
RAILS_MASTER_KEY=

# 数据库（Kamal 部署时由 deploy.yml + .kamal/secrets 注入）
QINGYU_DATABASE_PASSWORD=
QINGYU_DB_HOST=localhost
QINGYU_DB_PORT=5432
DB_USERNAME=postgres

# 认证服务商（mock | aliyun | tencent / xuexin）
ID_CARD_PROVIDER=mock
EDUCATION_PROVIDER=mock

# 短信服务商（Mock 模式下无需配置）
SMS_PROVIDER=mock

# Kamal 部署：镜像仓库令牌（GHCR 用 GitHub PAT，需 packages:write 权限）
KAMAL_REGISTRY_PASSWORD=
