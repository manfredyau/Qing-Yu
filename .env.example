# 生产环境必配（复制为 .env 或注入到容器环境）

# Rails 安全
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# 数据库（默认 qingyu / qingyu_dev 连接本地）
QINGYU_DATABASE_PASSWORD=
QINGYU_DB_HOST=localhost
QINGYU_DB_PORT=5432

# 实名信息加密密钥（bin/rails db:encryption:init 生成）
RAILS_ENCRYPTION_PRIMARY_KEY=
RAILS_ENCRYPTION_DETERMINISTIC_KEY=
RAILS_ENCRYPTION_KEY_DERIVATION_SALT=

# 认证服务商（mock | aliyun | tencent / xuexin）
ID_CARD_PROVIDER=mock
EDUCATION_PROVIDER=mock

# 短信服务商（Mock 模式下无需配置）
SMS_PROVIDER=mock
