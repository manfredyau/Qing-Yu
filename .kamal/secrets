# Kamal 2 密钥源（本文件不入库，安全起见从密码管理器/ENV/文件引用）
# 所有密钥在执行 bin/kamal envify / setup 时求值。

# RAILS_MASTER_KEY = 生产凭据解密密钥（= config/credentials/production.key 的内容，勿入库）
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# 数据库密码（同时用作 Postgres accessory 的 POSTGRES_PASSWORD）
QINGYU_DATABASE_PASSWORD=$QINGYU_DATABASE_PASSWORD

# 认证服务商选择（mock | aliyun | tencent / xuexin），生产替换为真实服务商
ID_CARD_PROVIDER=$ID_CARD_PROVIDER
EDUCATION_PROVIDER=$EDUCATION_PROVIDER

# 镜像仓库访问令牌（GHCR 用 GitHub PAT，需 packages:write 权限）
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
