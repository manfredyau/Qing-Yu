<% content_for(:title) { "实名认证 · 轻遇" } %>

<div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-5 py-8">
  <header class="mb-6 flex items-center gap-3">
    <%= link_to root_path, class: "flex h-9 w-9 items-center justify-center rounded-xl bg-white text-gray-500 shadow-sm" do %>
      <span aria-hidden="true">←</span>
    <% end %>
    <div>
      <h1 class="text-xl font-bold text-gray-900">实名认证</h1>
      <p class="text-sm text-gray-400">认证通过后才会出现在推荐中</p>
    </div>
  </header>

  <!-- 当前等级 -->
  <div class="mb-6 rounded-2xl bg-gradient-to-br from-teal-500 to-emerald-600 p-5 text-white shadow-md shadow-teal-200/60">
    <p class="text-sm opacity-90">当前认证等级</p>
    <p class="mt-1 text-2xl font-bold">
      <%= current_user.fully_verified? ? "V2 · 完全认证" : (current_user.verified? ? "V1 · 已实名" : "V0 · 未认证") %>
    </p>
    <p class="mt-2 text-xs leading-relaxed opacity-90">
      <%= current_user.fully_verified? ? "身份证 + 学信网均已通过，所有用户可见你最高信任标识" :
          (current_user.verified? ? "已完成身份证实名，建议继续完成学信网学历认证提升信任度" : "完成认证，开启轻遇之旅") %>
    </p>
  </div>

  <!-- 身份证 -->
  <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="font-semibold text-gray-900">身份证实名</h2>
        <p class="mt-1 text-xs text-gray-400">姓名 + 身份证号二要素核验（公安系统）</p>
      </div>
      <%= render "shared/verification_badges", verified: current_user.verified?, label: "已实名" %>
    </div>

    <% if @identity&.verified? %>
      <div class="mt-4 rounded-xl bg-teal-50 p-4 text-sm text-teal-800">
        <p>姓名：<%= @identity.full_name %></p>
        <p class="mt-1">证件号：<%= @identity.masked_id_number %></p>
        <p class="mt-1 text-xs text-teal-600">核验通过于 <%= l(@identity.verified_at, format: :short) %></p>
      </div>
    <% elsif @identity&.pending? %>
      <p class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-700">审核中，请稍候刷新查看结果。</p>
    <% elsif @identity&.rejected? %>
      <p class="mt-4 rounded-xl bg-red-50 p-4 text-sm text-red-600">上次核验失败：<%= @identity.rejection_reason %></p>
      <%= link_to "重新认证", new_identity_verification_path, class: "mt-3 block rounded-xl bg-teal-600 px-4 py-3 text-center font-semibold text-white hover:bg-teal-500" %>
    <% else %>
      <%= link_to "去认证", new_identity_verification_path, class: "mt-4 block rounded-xl bg-teal-600 px-4 py-3 text-center font-semibold text-white hover:bg-teal-500" %>
    <% end %>
  </div>

  <!-- 学信网 -->
  <div class="mt-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="font-semibold text-gray-900">学信网学历认证</h2>
        <p class="mt-1 text-xs text-gray-400">在线验证码 + 报告编号核验学籍/学历</p>
      </div>
      <%= render "shared/verification_badges", verified: @education&.verified?, label: "学历已认证" %>
    </div>

    <% if @education&.verified? %>
      <div class="mt-4 rounded-xl bg-teal-50 p-4 text-sm text-teal-800">
        <p><%= @education.school %> · <%= @education.degree %></p>
        <p class="mt-1 text-xs text-teal-600">核验通过于 <%= l(@education.verified_at, format: :short) %></p>
      </div>
    <% elsif @education&.pending? %>
      <p class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-700">审核中，请稍候刷新查看结果。</p>
    <% elsif @education&.rejected? %>
      <p class="mt-4 rounded-xl bg-red-50 p-4 text-sm text-red-600">上次核验失败：<%= @education.rejection_reason %></p>
      <%= link_to "重新认证", new_education_verification_path, class: "mt-3 block rounded-xl bg-teal-600 px-4 py-3 text-center font-semibold text-white hover:bg-teal-500" %>
    <% else %>
      <%= link_to "去认证", new_education_verification_path, class: "mt-4 block rounded-xl border border-teal-600 px-4 py-3 text-center font-semibold text-teal-600 hover:bg-teal-50" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-xs leading-relaxed text-gray-400">
    认证信息仅用于真实身份核验，依法加密存储<br>
    身份证号等敏感信息将不会被公开展示
  </p>
</div>
