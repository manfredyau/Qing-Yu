<% content_for(:title) { "匹配 · 轻遇" } %>

<div class="mx-auto min-h-screen w-full max-w-md px-5 py-8">
  <header class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 text-lg font-bold text-white">轻</div>
      <span class="text-lg font-bold tracking-tight text-gray-900">我的匹配</span>
    </div>
    <%= link_to "去推荐", feed_path, class: "rounded-lg bg-teal-50 px-3 py-1.5 text-sm font-medium text-teal-700" %>
  </header>

  <% if @matches.any? %>
    <div class="space-y-3">
      <% @matches.each do |match| %>
        <% other = match.other_user(current_user) %>
        <div class="flex items-center gap-3 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
          <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full bg-gray-100">
            <% if other.avatar_photo&.file&.attached? %>
              <%= image_tag other.avatar_photo.file.variant(resize_to_fill: [ 120, 120 ]), class: "h-full w-full object-cover" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center text-2xl">👤</div>
            <% end %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate font-semibold text-gray-900">
              <%= other.display_name %>
              <span class="ml-1 text-sm font-normal text-gray-400"><%= other.age %> 岁</span>
              <%= render "shared/verification_badges", verified: other.verified?, label: "已实名" %>
            </p>
            <p class="mt-0.5 truncate text-sm text-gray-400">
              <%= other.city.presence || "神秘用户" %> · 匹配于 <%= l(match.created_at, format: :short) %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="text-5xl">💌</div>
      <p class="mt-4 font-semibold text-gray-700">还没有配对</p>
      <p class="mt-1 text-sm text-gray-400">去推荐里右滑喜欢，互相喜欢即可配对</p>
      <%= link_to "开始今日推荐", feed_path, class: "mt-5 rounded-xl bg-teal-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  <% end %>
</div>
