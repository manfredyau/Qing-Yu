<% content_for(:title) { "消息 · 轻遇" } %>

<div class="mx-auto min-h-screen w-full max-w-md px-5 py-8">
  <header class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 text-lg font-bold text-white">轻</div>
      <span class="text-lg font-bold tracking-tight text-gray-900">消息</span>
    </div>
    <% if turbo_native_app? %>
      <!-- 原生壳：用 tab1 路径触发底部 Tab 切换到推荐，避免在消息 Tab 内部导航 -->
      <%= link_to "去推荐", hotwire_native_tab1_path, class: "rounded-lg bg-teal-50 px-3 py-1.5 text-sm font-medium text-teal-700" %>
    <% else %>
      <%= link_to "去推荐", feed_path, class: "rounded-lg bg-teal-50 px-3 py-1.5 text-sm font-medium text-teal-700" %>
    <% end %>
  </header>
  <% if turbo_native_app? %><p class="mb-4 text-right text-[10px] text-gray-300">下拉刷新</p><% end %>

  <% if @matches.any? %>
    <div class="space-y-3">
      <% @matches.each do |match| %>
        <% other = match.other_user(current_user) %>
        <% last = match.messages.last %>
        <% unread = match.unread_count_for(current_user) %>
        <%= link_to match_path(match), class: "flex items-center gap-3 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm transition hover:shadow-md" do %>
          <div class="relative h-14 w-14 shrink-0">
            <div class="h-14 w-14 overflow-hidden rounded-full bg-gray-100">
              <% avatar = other.avatar_photo %>
              <% if avatar&.file&.attached? %>
                <%= image_tag avatar.file.variant(resize_to_fill: [ 120, 120 ]), class: "h-full w-full object-cover" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center text-2xl">👤</div>
              <% end %>
              <% if avatar&.pending? %>
                <span class="absolute inset-x-0 bottom-0 bg-amber-500/80 py-0.5 text-center text-[8px] text-white">审核中</span>
              <% end %>
            </div>
            <% if unread > 0 %>
              <span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1.5 text-[10px] font-bold text-white"><%= [ unread, 99 ].min %></span>
            <% end %>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <p class="truncate font-semibold text-gray-900">
                <%= other.display_name %>
                <span class="ml-1 text-xs font-normal text-gray-400"><%= other.age %> 岁</span>
              </p>
              <% if last %>
                <span class="shrink-0 text-[10px] text-gray-300"><%= time_ago_in_words(last.created_at) %>前</span>
              <% end %>
            </div>
            <p class="mt-0.5 truncate text-sm text-gray-400">
              <%= last ? (last.sender_id == current_user.id ? "我：" : "") + last.body : "你们已配对，打个招呼吧 👋" %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="text-5xl">💌</div>
      <p class="mt-4 font-semibold text-gray-700">还没有配对</p>
      <p class="mt-1 text-sm text-gray-400">去推荐里右滑喜欢，互相喜欢即可配对</p>
      <% if turbo_native_app? %>
        <%= link_to "开始今日推荐", hotwire_native_tab1_path, class: "mt-5 rounded-xl bg-teal-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-teal-500" %>
      <% else %>
        <%= link_to "开始今日推荐", feed_path, class: "mt-5 rounded-xl bg-teal-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-teal-500" %>
      <% end %>
    </div>
  <% end %>
</div>
