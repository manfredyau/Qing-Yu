<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"
     data-controller="otp-countdown" data-otp-countdown-seconds-value="60">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">输入验证码</h2>
      <p class="mt-1 text-sm text-gray-500">已发送至 <span class="font-medium text-gray-700"><%= phone %></span></p>
    </div>
    <%= link_to "更换手机号", new_session_path, class: "shrink-0 text-sm text-teal-600 hover:text-teal-500" %>
  </div>

  <% if mock_code %>
    <div class="mt-4 rounded-xl border border-dashed border-amber-300 bg-amber-50 p-3 text-center">
      <p class="text-xs text-amber-600">开发模式演示：本次验证码为</p>
      <p class="mt-1 text-2xl font-bold tracking-[0.3em] text-amber-700"><%= mock_code %></p>
      <p class="mt-1 text-[10px] text-amber-500">真实环境通过短信下发，此处不显示</p>
    </div>
  <% end %>

  <%= form_with url: session_path, method: :post, data: { turbo_frame: "_top" }, class: "mt-6" do |f| %>
    <%= f.hidden_field :phone, value: phone %>
    <%= f.label :code, "验证码", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code",
          inputmode: "numeric", maxlength: 6, pattern: "\\d{6}", placeholder: "6 位数字",
          class: "mt-1.5 block w-full rounded-xl border border-gray-200 px-4 py-3 text-center text-2xl font-semibold tracking-[0.5em] shadow-sm placeholder:text-base placeholder:font-normal placeholder:tracking-normal placeholder:text-gray-300 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>
    <%= f.submit "登录", class: "mt-5 w-full cursor-pointer rounded-xl bg-teal-600 px-4 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-300" %>
  <% end %>

  <div class="mt-4 flex items-center justify-center gap-2 text-sm">
    <span data-otp-countdown-target="timer" class="text-gray-400"></span>
    <%= form_with url: login_code_path, method: :post, class: "inline" do |f| %>
      <%= f.hidden_field :phone, value: phone %>
      <%= f.submit "重新发送", disabled: true, data: { otp_countdown_target: "button" },
            class: "cursor-pointer text-teal-600 transition hover:text-teal-500 disabled:cursor-not-allowed disabled:text-gray-300" %>
    <% end %>
  </div>
</div>
