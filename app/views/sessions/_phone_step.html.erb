<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold text-gray-900">手机号登录</h2>
  <p class="mt-1 text-sm text-gray-500">新手机号将自动注册为轻遇用户</p>

  <%= form_with url: login_code_path, class: "mt-6" do |f| %>
    <%= f.label :phone, "手机号", class: "block text-sm font-medium text-gray-700" %>
    <%= f.telephone_field :phone, required: true, autofocus: true, autocomplete: "tel",
          inputmode: "numeric", pattern: "1[3-9]\\d{9}", maxlength: 11, placeholder: "请输入 11 位手机号",
          class: "mt-1.5 block w-full rounded-xl border border-gray-200 px-4 py-3 text-base shadow-sm placeholder:text-gray-300 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200" %>
    <%= f.submit "获取验证码", class: "mt-5 w-full cursor-pointer rounded-xl bg-teal-600 px-4 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-300" %>
  <% end %>
</div>
