<% if notice = flash[:notice] %>
  <div data-controller="dismiss" data-action="click->dismiss#hide" class="fixed inset-x-0 top-4 z-50 mx-auto w-full max-w-md px-4">
    <p class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 shadow-sm"><%= notice %></p>
  </div>
<% end %>

<% if alert = flash[:alert] %>
  <div data-controller="dismiss" data-action="click->dismiss#hide" class="fixed inset-x-0 top-4 z-50 mx-auto w-full max-w-md px-4">
    <p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600 shadow-sm"><%= alert %></p>
  </div>
<% end %>
