<% content_for(:title) { "我的 · 轻遇" } %>
<% content_for(:hotwire_native_title) { "我的" } %>

<div class="mx-auto min-h-screen w-full max-w-md px-5 py-8">
  <!-- 头像与昵称 -->
  <div class="flex items-center gap-4">
    <div class="relative h-20 w-20 overflow-hidden rounded-full bg-gray-100 ring-2 ring-white shadow-md">
      <% avatar = current_user.avatar_photo %>
      <% if avatar&.file&.attached? %>
        <%= image_tag avatar.file.variant(resize_to_fill: [ 160, 160 ]), class: "h-full w-full object-cover" %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-4xl">👤</div>
      <% end %>
      <% if avatar&.pending? %>
        <span class="absolute inset-x-0 bottom-0 bg-amber-500/80 py-0.5 text-center text-[9px] text-white">审核中</span>
      <% end %>
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold text-gray-900"><%= current_user.display_name %></h1>
        <%= render "shared/verification_badges", verified: current_user.verified?, label: "已实名" %>
      </div>
      <p class="mt-1 text-sm text-gray-500">
        <%= [ current_user.gender_label, (current_user.age ? "#{current_user.age}岁" : nil), current_user.city ].compact.join(" · ") %>
      </p>
      <p class="mt-0.5 text-xs text-gray-400">
        <%= current_user.fully_verified? ? "V2 · 身份证 + 学信网已认证" : (current_user.verified? ? "V1 · 身份证已认证" : "未完成实名认证") %>
      </p>
    </div>
  </div>

  <!-- 功能入口 -->
  <div class="mt-8 space-y-3">
    <%= link_to edit_profile_path, class: "flex items-center justify-between rounded-2xl border border-gray-100 bg-white p-4 shadow-sm" do %>
      <span class="font-medium text-gray-700">编辑资料</span>
      <span class="text-gray-300">→</span>
    <% end %>
    <%= link_to verification_path, class: "flex items-center justify-between rounded-2xl border border-gray-100 bg-white p-4 shadow-sm" do %>
      <span class="font-medium text-gray-700">实名认证</span>
      <span class="text-xs text-gray-400"><%= current_user.fully_verified? ? "已完全认证" : "去认证 →" %></span>
    <% end %>
    <% unless turbo_native_app? %>
      <%= link_to matches_path, class: "flex items-center justify-between rounded-2xl border border-gray-100 bg-white p-4 shadow-sm" do %>
        <span class="font-medium text-gray-700">我的匹配</span>
        <span class="text-gray-300">→</span>
      <% end %>
      <%= link_to feed_path, class: "flex items-center justify-between rounded-2xl border border-gray-100 bg-white p-4 shadow-sm" do %>
        <span class="font-medium text-gray-700">每日推荐</span>
        <span class="text-gray-300">→</span>
      <% end %>
    <% end %>
  </div>

  <div class="mt-8 space-y-3">
    <%= button_to "退出登录", session_path, method: :delete, class: "w-full cursor-pointer rounded-2xl border border-gray-200 bg-white p-4 text-center font-medium text-gray-500 hover:bg-gray-50" %>
  </div>

  <p class="mt-8 text-center text-xs text-gray-300">轻遇 · 实名制交友，减少信息过载</p>
</div>
