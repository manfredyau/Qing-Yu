<div class="mt-4">
  <div class="grid grid-cols-3 gap-2">
    <% user.photos.ordered.each do |photo| %>
      <div class="relative aspect-square overflow-hidden rounded-xl bg-gray-100">
        <% if photo.file.attached? %>
          <%= image_tag photo.file.variant(resize_to_fill: [ 300, 300 ]), class: "h-full w-full object-cover" %>
        <% end %>

        <% if photo.approved? && photo.primary? %>
          <span class="absolute left-1 top-1 rounded-full bg-teal-600 px-2 py-0.5 text-[10px] font-medium text-white">头像</span>
        <% elsif photo.pending? %>
          <span class="absolute inset-x-0 bottom-0 bg-amber-500/80 py-1 text-center text-[10px] text-white">审核中</span>
        <% elsif photo.rejected? %>
          <span class="absolute inset-x-0 bottom-0 bg-red-500/80 py-1 text-center text-[10px] text-white">未通过</span>
        <% end %>

        <div class="absolute bottom-1 right-1 flex gap-1">
          <% if photo.approved? && !photo.primary? %>
            <%= button_to "设为头像", set_primary_photo_path(photo), method: :patch,
                  class: "cursor-pointer rounded-md bg-white/90 px-1.5 py-0.5 text-[10px] text-gray-700 shadow-sm" %>
          <% end %>
          <%= button_to "删除", photo_path(photo), method: :delete,
                data: { turbo_confirm: "确定删除这张照片？" },
                class: "cursor-pointer rounded-md bg-white/90 px-1.5 py-0.5 text-[10px] text-red-500 shadow-sm" %>
        </div>
      </div>
    <% end %>

    <!-- 上传占位（XHR 直传 + 进度条） -->
    <div data-controller="photo-upload" class="flex flex-col gap-2">
      <label for="photo_upload" class="flex aspect-square cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-gray-200 text-gray-400 hover:border-teal-400 hover:text-teal-500">
        <span class="text-2xl leading-none">+</span>
        <span class="text-[10px]">添加照片</span>
      </label>
      <input type="file" id="photo_upload" accept="image/jpeg,image/png,image/webp" class="hidden"
             data-photo-upload-target="input" data-action="change->photo-upload#upload">
      <div data-photo-upload-target="progress" class="hidden h-1.5 w-full overflow-hidden rounded-full bg-gray-100">
        <div data-photo-upload-target="bar" class="h-full rounded-full bg-teal-500 transition-all duration-200" style="width:0%"></div>
      </div>
      <p data-photo-upload-target="status" class="text-[10px] text-gray-400"></p>
    </div>
  </div>
  <p class="mt-2 text-xs text-gray-400">最多 6 张 · JPG / PNG / WebP · 单张不超过 10MB</p>
</div>
