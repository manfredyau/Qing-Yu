<%= turbo_stream.replace "feed-card" do %>
  <%= render "feeds/card", candidate: @candidate, remaining: @remaining, matched_user: @matched_user %>
<% end %>

<% if @candidate %>
  <%= turbo_stream.replace "feed-remaining" do %>
    <%= render "feeds/remaining", remaining: @remaining, candidate: @candidate %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "feed-remaining" %>
<% end %>
