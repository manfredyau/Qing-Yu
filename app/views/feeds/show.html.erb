<% content_for(:title) { "今日推荐 · 轻遇" } %>

<% if turbo_native_app? %>
  <script>
    // WebView 缓存顽固时的兜底：无卡片元素说明加载了旧版页面，自动刷新一次
    (function() {
      if (document.querySelector("#feed-card")) return;
      var key = "feed-reloaded-" + new Date().toDateString();
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, "1");
        location.reload();
      }
    })();
  </script>
<% end %>

<div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-5 py-6">
  <header class="mb-5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 text-lg font-bold text-white">轻</div>
      <span class="text-lg font-bold tracking-tight text-gray-900">今日推荐</span>
    </div>
    <%= render "feeds/remaining", remaining: @remaining, candidate: @candidate %>
    <% if turbo_native_app? %><span class="text-[10px] text-gray-300">下拉刷新</span><% end %>
  </header>

  <% if !current_user.verified? %>
    <!-- 未实名：引导认证 -->
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="text-5xl">🔒</div>
      <p class="mt-4 text-lg font-semibold text-gray-700">完成实名认证，开启轻遇之旅</p>
      <p class="mt-1 text-sm leading-relaxed text-gray-400">实名认证后，你才会出现在推荐中<br>身份证 + 学信网双重核验，保证真实</p>
      <%= link_to "去实名认证", verification_path, class: "mt-6 rounded-xl bg-teal-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-teal-500" %>
    </div>
  <% elsif !current_user.profile_complete? %>
    <!-- 已实名但资料不完整：明确列出缺什么（避免"保存了但没反应"的困惑） -->
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <div class="text-5xl">📝</div>
      <p class="mt-4 text-lg font-semibold text-gray-700">完善资料，让推荐更精准</p>
      <p class="mt-1 text-sm leading-relaxed text-gray-400">
        还差：<%= current_user.missing_profile_parts.join("、") %>
      </p>
      <%= link_to "去完善资料", edit_profile_path, class: "mt-6 rounded-xl bg-teal-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-teal-500" %>
      <% if turbo_native_app? %><p class="mt-4 text-[10px] text-gray-300">下拉刷新页面</p><% end %>
    </div>
  <% else %>
    <%= render "feeds/card", candidate: @candidate, remaining: @remaining, matched_user: nil %>
    <p class="mt-6 text-center text-xs text-gray-400">左滑/✕ 跳过 · 右滑/♥ 喜欢 · 互相喜欢即配对</p>
  <% end %>
</div>
