<% content_for(:title) { "今日推荐 · 轻遇" } %>

<div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-5 py-6">
  <header class="mb-5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 text-lg font-bold text-white">轻</div>
      <span class="text-lg font-bold tracking-tight text-gray-900">今日推荐</span>
    </div>
    <span class="rounded-full bg-white px-3 py-1.5 text-xs font-medium text-teal-700 shadow-sm" id="feed-remaining">
      今日剩余 <%= @remaining %> 次
    </span>
  </header>

  <%= render "feeds/card", candidate: @candidate, remaining: @remaining, matched_user: nil %>

  <p class="mt-6 text-center text-xs text-gray-400">左滑/✗ 跳过 · 右滑/✓ 喜欢 · 互相喜欢即配对</p>
</div>
