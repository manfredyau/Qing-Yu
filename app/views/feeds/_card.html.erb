<turbo-frame id="feed-card" class="block">
  <% if matched_user %>
    <%= render "feeds/match_banner", matched_user: matched_user %>
  <% end %>

  <% if candidate %>
    <div data-controller="swipe-card" class="relative">
      <!-- 卡片 -->
      <div class="touch-none select-none overflow-hidden rounded-3xl bg-white shadow-xl shadow-gray-200/70">
        <div class="relative aspect-[3/4]">
          <% avatar = candidate.avatar_photo %>
          <% if avatar&.file&.attached? %>
            <%= image_tag avatar.file.variant(resize_to_fill: [ 600, 800 ]), class: "h-full w-full object-cover", draggable: false %>
            <% if avatar.pending? %>
              <!-- 照片待审核：向其他用户标注「审核中」，但不阻塞对方资料 -->
              <span class="absolute inset-x-0 top-3 flex justify-center">
                <span class="rounded-full bg-amber-500/90 px-2.5 py-0.5 text-[10px] font-medium text-white backdrop-blur">照片审核中</span>
              </span>
            <% end %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-teal-100 to-emerald-100 text-7xl">👤</div>
          <% end %>

          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent p-5 pt-20 text-white">
            <div class="flex items-center gap-2">
              <h2 class="text-2xl font-bold"><%= candidate.display_name %></h2>
              <% if candidate.age %>
                <span class="text-lg"><%= candidate.age %></span>
              <% end %>
              <%= render "shared/verification_badges", verified: candidate.verified?, label: "已实名" %>
              <% if candidate.fully_verified? %>
                <span class="rounded-full bg-white/20 px-2 py-0.5 text-[10px] backdrop-blur">🎓 学历已认证</span>
              <% end %>
            </div>
            <p class="mt-1 text-sm text-white/90">
              <%= [ candidate.city, candidate.height_label, User.education_level_label(candidate.education_level), candidate.job ].compact.reject(&:empty?).join(" · ") %>
            </p>
            <% if candidate.verified_school %>
              <p class="mt-0.5 text-sm text-white/80">🎓 <%= candidate.verified_school %></p>
            <% end %>
          </div>
        </div>

        <div class="p-5">
          <% if candidate.bio.present? %>
            <p class="text-sm leading-relaxed text-gray-600"><%= candidate.bio %></p>
          <% end %>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <% candidate.interests.limit(6).each do |interest| %>
              <span class="rounded-full bg-teal-50 px-2.5 py-1 text-xs text-teal-700"><%= interest.name %></span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- 操作按钮 -->
      <div class="mt-5 flex items-center justify-center gap-8">
        <%= button_to swipes_path, method: :post, params: { target_id: candidate.id, decision: "pass" },
              data: { swipe_card_target: "passForm" },
              class: "flex h-16 w-16 items-center justify-center rounded-full border-2 border-gray-200 bg-white text-2xl text-gray-400 shadow-md transition hover:border-red-300 hover:text-red-400" do %>
          <span aria-hidden="true">✕</span>
        <% end %>
        <%= button_to swipes_path, method: :post, params: { target_id: candidate.id, decision: "like" },
              data: { swipe_card_target: "likeForm" },
              class: "flex h-16 w-16 items-center justify-center rounded-full border-2 border-teal-200 bg-teal-500 text-2xl text-white shadow-md shadow-teal-200/60 transition hover:bg-teal-400" do %>
          <span aria-hidden="true">♥</span>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "feeds/empty", remaining: remaining %>
  <% end %>
</turbo-frame>
