<% content_for(:title) { "首页 · 轻遇" } %>

<div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-6 py-8">
  <header class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 text-lg font-bold text-white">轻</div>
      <span class="text-lg font-bold tracking-tight text-gray-900">轻遇</span>
    </div>
    <%= button_to "退出登录", session_path, method: :delete,
          class: "cursor-pointer rounded-lg px-3 py-1.5 text-sm text-gray-500 transition hover:bg-gray-100" %>
  </header>

  <main class="mt-10 flex-1">
    <h1 class="text-2xl font-bold text-gray-900">Hi，<%= current_user.display_name %> 👋</h1>

    <!-- 认证状态卡片 -->
    <%= link_to verification_path, class: "mt-6 block" do %>
      <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:shadow-md">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-400">认证等级</p>
            <p class="mt-0.5 text-lg font-semibold text-gray-900">
              <%= current_user.fully_verified? ? "V2 · 完全认证" : (current_user.verified? ? "V1 · 已实名" : "V0 · 未认证") %>
            </p>
          </div>
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-teal-50 text-xl">🔒</span>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-gray-400">
          <% if current_user.fully_verified? %>
            身份证 + 学信网均已通过，你拥有最高信任标识
          <% elsif current_user.verified? %>
            已通过身份证实名，建议继续完成学信网学历认证
          <% else %>
            完成实名认证后，才会出现在推荐中 → 立即认证
          <% end %>
        </p>
      </div>
    <% end %>

    <div class="mt-4 rounded-2xl border border-dashed border-gray-200 bg-white p-6 text-center">
      <p class="text-sm font-medium text-gray-500">每日精选推荐</p>
      <p class="mt-1 text-xs text-gray-400">M4 上线：每天只推荐几位，不刷屏</p>
    </div>

    <!-- 资料完整度 -->
    <%= link_to edit_profile_path, class: "mt-4 block" do %>
      <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:shadow-md">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-gray-700">资料完整度</p>
          <% if current_user.profile_complete? %>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-600">✓ 已完善</span>
          <% else %>
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-600">待完善</span>
          <% end %>
        </div>
        <p class="mt-2 text-xs text-gray-400">昵称、照片、兴趣标签等会让推荐更精准</p>
      </div>
    <% end %>
  </main>
</div>
